# Backend environment. Copy to `.env` and adjust. NEVER commit the real .env.

# --- Database ---
# SQLite (zero-setup, default for the academic prototype):
DATABASE_URL=sqlite:///./circular.db
# PostgreSQL (production-compatible — uncomment and install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://cem_user:cem_pass@localhost:5432/circular

# --- Auth (used from Phase 7) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=120

# --- CORS (used from Phase 6) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Email verification (Feature 1) ---
# Dev mode: no mail server; codes go to data/dev_outbox/ and the account owner can
# fetch their own code via GET /api/auth/dev/verification-code. Set to false and
# fill SMTP_* to send real email. Never commit real SMTP credentials.
EMAIL_DEV_MODE=true
EMAIL_FROM=no-reply@circular.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
RESEND_MAX_PER_HOUR=5

# --- Material pricing (Feature 2) ---
# Optional market-data feed. Leave empty to use admin-managed reference prices
# (shown to users as "Reference - not live"). The adapter in
# app/services/pricing_service.py::_fetch_from_feed expects GET {BASE}/{material}
# -> {"price", "currency": "INR", "unit", "timestamp"}; adapt it to your provider.
PRICE_API_BASE_URL=
PRICE_API_KEY=
PRICE_STALE_AFTER_HOURS=24
