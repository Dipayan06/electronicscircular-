# Backend environment. Copy to `.env` and adjust. NEVER commit the real .env.

# --- Database ---
# SQLite (zero-setup, default for the academic prototype):
DATABASE_URL=sqlite:///./circular.db
# PostgreSQL (production-compatible — uncomment and install psycopg2-binary):
# DATABASE_URL=postgresql+psycopg2://cem_user:cem_pass@localhost:5432/circular

# --- Auth (used from Phase 7) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=120

# --- CORS (used from Phase 6) ---
FRONTEND_ORIGIN=http://localhost:5173
